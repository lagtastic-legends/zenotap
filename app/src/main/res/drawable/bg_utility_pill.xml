<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#2D313E" />
            <stroke android:width="1dp" android:color="#06B6D4" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#242835" />
            <stroke android:width="1dp" android:color="#8B5CF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#1B1C23" />
            <stroke android:width="1dp" android:color="#333440" />
        </shape>
    </item>
</selector>
