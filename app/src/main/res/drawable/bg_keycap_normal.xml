<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with neon cyan specular glow and recessed depth -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Outer bezel shadow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <!-- Recessed inner body with active neon border -->
            <item android:top="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#1A1D24" />
                    <stroke android:width="1.5dp" android:color="#06B6D4" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Focused / Selected state -->
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:top="1dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#242834" />
                    <stroke android:width="1dp" android:color="#8B5CF6" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal unpressed tactile keycap state with top specular highlight -->
    <item>
        <layer-list>
            <!-- Bottom bezel shadow for physical keycap depth -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#0D0E12" />
                </shape>
            </item>
            <!-- Main elevated keycap body with 1dp top specular highlight -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#27272E" />
                    <stroke android:width="1dp" android:color="#3F3F4E" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
