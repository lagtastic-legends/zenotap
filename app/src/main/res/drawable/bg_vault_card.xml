<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with neon cyan specular glow and recessed depth -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#252836" />
            <stroke android:width="1.5dp" android:color="#06B6D4" />
        </shape>
    </item>

    <!-- Normal 12dp glassmorphic card surface with specular border -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1A1B24" />
            <stroke android:width="1dp" android:color="#2E303F" />
        </shape>
    </item>
</selector>
