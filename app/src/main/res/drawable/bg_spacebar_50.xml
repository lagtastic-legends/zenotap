<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with illuminated cyber LED trackpad glow -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Shadow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <!-- Recessed body -->
            <item android:top="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#181822" />
                    <stroke android:width="1.5dp" android:color="#06B6D4" />
                </shape>
            </item>
            <!-- Illuminated Center Trackpad LED Pill -->
            <item android:gravity="center" android:width="44dp" android:height="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#22D3EE" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal state with 3D tactile bevel and centered trackpad LED pill -->
    <item>
        <layer-list>
            <!-- Bottom bezel drop shadow for depth -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#0B0B10" />
                </shape>
            </item>
            <!-- Main spacebar body with subtle brushed finish and 1dp specular stroke -->
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#282834" />
                    <stroke android:width="1dp" android:color="#424256" />
                </shape>
            </item>
            <!-- Center Trackpad LED Pill Indicator -->
            <item android:gravity="center" android:width="36dp" android:height="3dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <corners android:radius="2dp" />
                    <solid android:color="#64748B" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
