<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed state with cyber-violet specular glow and recessed depth -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#000000" />
                </shape>
            </item>
            <item android:top="2dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#171720" />
                    <stroke android:width="1.5dp" android:color="#A855F7" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal special/utility keycap with deeper slate tint and 1dp highlight -->
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#0A0A0E" />
                </shape>
            </item>
            <item android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="8dp" />
                    <solid android:color="#1F1F28" />
                    <stroke android:width="1dp" android:color="#363645" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
