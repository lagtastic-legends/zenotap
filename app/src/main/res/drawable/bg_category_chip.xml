<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#241E38" />
            <stroke android:width="1dp" android:color="#A855F7" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#1F232D" />
            <stroke android:width="1dp" android:color="#06B6D4" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="#181920" />
            <stroke android:width="1dp" android:color="#2D2F3A" />
        </shape>
    </item>
</selector>
