<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="270dp"
    android:minHeight="260dp"
    android:orientation="vertical"
    android:background="#121214"
    android:padding="6dp">

    <!-- Top Bar: Header & Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_deck_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡ ZenoTap GIF Deck"
                    android:textColor="#F4F4F5"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_rich_content_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#27272A"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="CommitContent"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_keyboard_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Detecting host app capabilities..."
                android:textColor="#A1A1AA"
                android:textSize="9sp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Switch IME Button -->
        <ImageButton
            android:id="@+id/btn_switch_ime"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Switch Keyboard"
            android:src="@android:drawable/ic_menu_agenda"
            android:tint="#D4D4D8" />

        <!-- Close Keyboard Button -->
        <ImageButton
            android:id="@+id/btn_close_keyboard"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close Keyboard"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#A1A1AA" />
    </LinearLayout>

    <!-- Main Content Frame: RecyclerView Grid & Empty State -->
    <FrameLayout
        android:id="@+id/media_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:minHeight="170dp"
        android:layout_weight="1"
        android:background="#18181B">

        <!-- RecyclerView for Media Cards -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gif_deck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="vertical"
            android:visibility="visible" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_empty_deck"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎨 No GIFs in Deck"
                android:textColor="#F4F4F5"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_deck_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="Add GIF animations to your ZenoTap deck to inject with 1-tap."
                android:textColor="#71717A"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_create_sample"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginTop="10dp"
                android:background="#059669"
                android:text="🚀 Add Sample Reaction"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:paddingHorizontal="12dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Action & Telemetry Strip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btn_open_app"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#27272A"
            android:text="Open ZenoTap"
            android:textAllCaps="false"
            android:textColor="#E4E4E7"
            android:textSize="10sp"
            android:paddingHorizontal="10dp" />

        <TextView
            android:id="@+id/tv_commit_result"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Ready for media injection"
            android:textColor="#9CA3AF"
            android:textSize="9sp"
            android:singleLine="true"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btn_switch_input"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:background="#27272A"
            android:text="⌨ Switch IME"
            android:textAllCaps="false"
            android:textColor="#A1A1AA"
            android:textSize="10sp"
            android:paddingHorizontal="10dp" />
    </LinearLayout>

</LinearLayout>
