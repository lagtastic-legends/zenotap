<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_gif_root"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:layout_margin="3dp"
    android:background="@drawable/bg_vault_card"
    android:clipToOutline="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <!-- Thumbnail Preview Image -->
    <ImageView
        android:id="@+id/iv_gif_thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="GIF Preview" />

    <!-- Top-Right Pin / Favorite Badges Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_fav_badge"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/ic_star_filled"
            android:tint="#F59E0B"
            android:visibility="gone"
            android:contentDescription="Favorite" />

        <TextView
            android:id="@+id/tv_pin_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:background="@drawable/bg_format_badge"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="📌"
            android:textSize="8sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Metadata Bar: Filename, Format Badge, and File Size -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC0A0B10"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="5dp"
        android:paddingVertical="3dp">

        <TextView
            android:id="@+id/tv_gif_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#F1F5F9"
            android:textSize="9sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <!-- Format Micro Badge (GIF / STICKER) -->
        <TextView
            android:id="@+id/tv_gif_format"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/bg_format_badge"
            android:paddingHorizontal="3dp"
            android:paddingVertical="1dp"
            android:text="GIF"
            android:textColor="#38BDF8"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gif_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94A3B8"
            android:textSize="8sp" />
    </LinearLayout>

</FrameLayout>
